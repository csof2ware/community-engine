import { config } from 'dotenv';
import path from 'path';
import { fileURLToPath } from 'url';
const __dirname = path.dirname(fileURLToPath(import.meta.url));
config({ path: path.resolve(__dirname, '..', '..', '.env') });

import { Client, GatewayIntentBits, REST, Routes, SlashCommandBuilder, EmbedBuilder } from 'discord.js';
import Redis from 'ioredis';

const { DISCORD_TOKEN, DISCORD_CLIENT_ID, DISCORD_GUILD_ID } = process.env;
const SIGNER = 'http://localhost:3001';
const RELAYER = 'http://localhost:3002';
const BADGE = 'http://localhost:3003';
const GRAPH = 'http://graph-node:8000/subgraphs/name/airdrop-v2';
const ADDR_RE = /^0x[0-9a-fA-F]{40}$/;
const redis = new Redis('redis://redis:6379');

const MILE = {
  7:  { name: 'Day-7 · Initiate',        color: 0xCD7F32, badge: 7 },
  14: { name: 'Day-14 · Builder',        color: 0xC0C0C0, badge: 14 },
  21: { name: 'Day-21 · On-Chain Master', color: 0xFFD700, badge: 21 }
};

process.on('unhandledRejection', (e) => console.error('[unhandled]', e?.message || e));
process.on('uncaughtException', (e) => console.error('[uncaught]', e?.message || e));

async function fetchT(url, opts = {}, ms = 12000) {
  const c = new AbortController(); const id = setTimeout(() => c.abort(), ms);
  try { return await fetch(url, { ...opts, signal: c.signal }); } finally { clearTimeout(id); }
}
const validAddr = a => typeof a === 'string' && ADDR_RE.test(a);
const fmt = b => { try { return BigInt(b).toString(); } catch { return String(b ?? '0'); } };

async function ensureRole(guild, name, color) {
  let r = guild.roles.cache.find(x => x.name === name);
  if (!r) r = await guild.roles.create({ name, color, reason: 'MintPass milestone' });
  return r;
}

const commands = [
  new SlashCommandBuilder().setName('ping').setDescription('MintPass esta vivo?'),
  new SlashCommandBuilder().setName('claim').setDescription('Claim gasless (relayer paga o gas)')
    .addStringOption(o => o.setName('address').setDescription('Seu endereco 0x...').setRequired(true))
    .addStringOption(o => o.setName('amount').setDescription('Quantidade (default 1)')),
  new SlashCommandBuilder().setName('balance').setDescription('Saldo on-chain via The Graph')
    .addStringOption(o => o.setName('address').setDescription('Endereco 0x...').setRequired(true)),
  new SlashCommandBuilder().setName('leaderboard').setDescription('Top 5 holders do airdrop'),
  new SlashCommandBuilder().setName('link').setDescription('Vincula sua wallet ao Discord')
    .addStringOption(o => o.setName('address').setDescription('Seu endereco 0x...').setRequired(true)),
  new SlashCommandBuilder().setName('approve-day').setDescription('MOD: aprova um dia do desafio')
    .addUserOption(o => o.setName('user').setDescription('Aluno').setRequired(true))
    .addIntegerOption(o => o.setName('day').setDescription('Dia 1-21').setRequired(true)),
  new SlashCommandBuilder().setName('myprogress').setDescription('Seus dias aprovados')
].map(c => c.toJSON());

const client = new Client({ intents: [GatewayIntentBits.Guilds, GatewayIntentBits.GuildMembers] });
client.on('error', (e) => console.error('[client error]', e?.message || e));
client.once('clientReady', () => console.log('[bot] online como ' + client.user.tag));

client.on('interactionCreate', async (i) => {
  if (!i.isChatInputCommand()) return;
  try {
    if (i.commandName === 'ping') {
      await i.reply('🏓 pong · MintPass Engine v1');
      return;
    }

    if (i.commandName === 'link') {
      const a = i.options.getString('address');
      if (!validAddr(a)) return i.reply({ content: '❌ endereco invalido', ephemeral: true });
      await redis.set('link:' + i.user.id, a);
      return i.reply({ content: '🔗 wallet vinculada: ' + a + '', ephemeral: true });
    }

    if (i.commandName === 'myprogress') {
      const days = await redis.smembers('progress:' + i.user.id);
      const n = days.length;
      return i.reply({ content: '📚 dias aprovados: *' + n + '/21*' + (n ? ' → [' + days.sort((x,y)=>x-y).join(', ') + ']' : ''), ephemeral: true });
    }

    if (i.commandName === 'approve-day') {
      if (!i.member.permissions.has('ManageGuild'))
        return i.reply({ content: '❌ só moderadores aprovam dias', ephemeral: true });
      const target = i.options.getUser('user');
      const day = i.options.getInteger('day');
      if (day < 1 || day > 21) return i.reply({ content: '❌ dia deve ser 1-21', ephemeral: true });
      await redis.sadd('progress:' + target.id, day);
      const count = await redis.scard('progress:' + target.id);
      let extra = '';
      if (MILE[count]) {
        const wallet = await redis.get('link:' + target.id);
        if (!wallet) {
          extra = '\n⚠️ marco ' + count + ' atingido, mas o aluno ainda nao deu /link — badge pendente.';
        } else {
          try {
            const r = await fetchT(BADGE + '/mint-badge', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ claimant: wallet, badgeId: MILE[count].badge }) });
            const out = await r.json();
            if (!r.ok) throw new Error(out.error || r.status);
            const member = await i.guild.members.fetch(target.id);
            const role = await ensureRole(i.guild, MILE[count].name, MILE[count].color);
            await member.roles.add(role);
            extra = '\n🎖️ *BADGE MINTADO* (' + MILE[count].name + ') tx ' + out.txHash.slice(0, 18) + ' + cargo concedido!';
          } catch (e) { extra = '\n❌ badge falhou: ' + e.message; }
        }
      }
      return i.reply({ content: '✅ *' + target.username + '* agora tem *' + count + '/21* dias.' + extra });
    }

    if (i.commandName === 'claim') {
      const address = i.options.getString('address');
      const amount = i.options.getString('amount') || '1';
      if (!validAddr(address)) return i.reply({ content: '❌ endereco invalido', ephemeral: true });
      await i.deferReply();
      const s = await fetchT(SIGNER + '/sign', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ claimant: address, amount }) });
      if (!s.ok) throw new Error('signer ' + s.status);
      const signed = await s.json();
      const r = await fetchT(RELAYER + '/relay', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(signed) });
      if (!r.ok) { const e = await r.json().catch(() => ({})); throw new Error(e.error || ('relayer ' + r.status)); }
      const out = await r.json();
      const emb = new EmbedBuilder().setColor(0x57F287).setTitle('✅ Claim gasless minerada')
        .addFields({ name: 'Endereco', value: '' + address + '' }, { name: 'Saldo', value: '' + out.newBalance + '', inline: true }, { name: 'Bloco', value: '' + out.blockNumber + '', inline: true }, { name: 'TX', value: '' + out.txHash + '' })
        .setFooter({ text: 'MintPass · relayer pagou o gas' });
      await i.editReply({ embeds: [emb] });
      return;
    }

    if (i.commandName === 'balance') {
      const address = i.options.getString('address');
      if (!validAddr(address)) return i.reply({ content: '❌ endereco invalido', ephemeral: true });
      await i.deferReply();
      const res = await fetchT(GRAPH, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ query: '{ holder(id: "' + address.toLowerCase() + '") { balance transferCount } }' }) });
      const h = (await res.json())?.data?.holder;
      if (!h) return i.editReply({ content: '🔍 sem registro on-chain para ' + address + '' });
      const emb = new EmbedBuilder().setColor(0x5865F2).setTitle('💼 Saldo on-chain')
        .addFields({ name: 'Balance', value: '' + fmt(h.balance) + '', inline: true }, { name: 'Transfers', value: '' + h.transferCount + '', inline: true });
      await i.editReply({ embeds: [emb] });
      return;
    }

    if (i.commandName === 'leaderboard') {
      await i.deferReply();
      const res = await fetchT(GRAPH, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ query: '{ holders(first: 5, orderBy: balance, orderDirection: desc) { id balance transferCount } }' }) });
      const hs = (await res.json())?.data?.holders || [];
      if (!hs.length) return i.editReply({ content: '🔍 nenhum holder ainda' });
      const rows = hs.map((h, idx) => (['🥇','🥈',''][idx] || '  ') + ' ' + h.id.slice(0,6) + '..' + h.id.slice(-4) + ' · *' + fmt(h.balance) + '* · ' + h.transferCount + ' tx').join('\n');
      await i.editReply({ embeds: [new EmbedBuilder().setColor(0xFEE75C).setTitle('🏆 Top 5 Holders').setDescription(rows)] });
      return;
    }
  } catch (e) {
    console.error('[interaction] erro:', e?.message || e);
    const m = '❌ ' + (e?.message || 'erro desconhecido');
    if (i.deferred || i.replied) { try { await i.editReply({ content: m }); } catch {} }
    else { try { await i.reply({ content: m, ephemeral: true }); } catch {} }
  }
});

const rest = new REST({ version: '10' }).setToken(DISCORD_TOKEN);
await rest.put(Routes.applicationGuildCommands(DISCORD_CLIENT_ID, DISCORD_GUILD_ID), { body: commands });
console.log('[bot] comandos: /ping /claim /balance /leaderboard /link /approve-day /myprogress');
await client.login(DISCORD_TOKEN);
